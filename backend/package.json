{
  "name": "dropship-management-backend",
  "version": "1.0.0",
  "description": "Microservices Backend API for Multi-Business Dropshipping Platform",
  "type": "module",
  "main": "services/api-gateway/server.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:business\" \"npm run dev:product\" \"npm run dev:order\" \"npm run dev:marketing\" \"npm run dev:analytics\"",
    "dev:gateway": "nodemon --exec \"node --max-old-space-size=2048\" services/api-gateway/server.js",
    "dev:auth": "nodemon --exec \"node --max-old-space-size=2048\" services/auth-service/server.js",
    "dev:business": "nodemon --exec \"node --max-old-space-size=2048\" services/business-dealer-service/server.js",
    "dev:product": "nodemon --exec \"node --max-old-space-size=2048\" services/product-service/server.js",
    "dev:order": "nodemon --exec \"node --max-old-space-size=2048\" services/order-service/server.js",
    "dev:marketing": "nodemon --exec \"node --max-old-space-size=2048\" services/marketing-service/server.js",
    "dev:analytics": "nodemon --exec \"node --max-old-space-size=2048\" services/analytics-service/server.js",
    "start": "concurrently \"node services/api-gateway/server.js\" \"node services/auth-service/server.js\" \"node services/business-dealer-service/server.js\" \"node services/product-service/server.js\" \"node services/order-service/server.js\" \"node services/marketing-service/server.js\" \"node services/analytics-service/server.js\"",
    "start:gateway": "node services/api-gateway/server.js",
    "start:auth": "nodemon --exec \"node --max-old-space-size=2048\" services/auth-service/server.js",
    "start:business": "nodemon --exec \"node --max-old-space-size=2048\" services/business-dealer-service/server.js",
    "start:product": "nodemon --exec \"node --max-old-space-size=2048\" services/product-service/server.js",
    "start:order": "nodemon --exec \"node --max-old-space-size=2048\" services/order-service/server.js",
    "start:marketing": "nodemon --exec \"node --max-old-space-size=2048\" services/marketing-service/server.js",
    "start:analytics": "nodemon --exec \"node --max-old-space-size=2048\" services/analytics-service/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js",
    "db:reset": "node scripts/seed.js",
    "db:seed": "node scripts/seed.js",
    "cache:inspect": "node scripts/inspect-cache.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-http-proxy": "^2.1.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.0.0"
  }
}
